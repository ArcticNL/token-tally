# Settings for token-tally.service. Copy to ~/token-tally-office/office.env and fill in.
# office.env is ignored by git: it describes your network, so keep it out of the repo.
#
#   --host 0.0.0.0              listen on the whole home network
#   --allow-host NAME           every name or IP you'll type in the browser (repeat for each)
#   --extra-url URL             another address of this office, e.g. over Tailscale; PCs fall back to it
#   --hook-key-file hook.key    the secret every PC's relay must send (required beyond localhost)
OFFICE_ARGS=--host 0.0.0.0 --allow-host <office-ip> --allow-host <office-hostname> --hook-key-file hook.key
