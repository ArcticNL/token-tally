# Copy this file to .env and fill it in. .env stays out of git.

# The address(es) you open the office on, comma-separated: the machine's IP and/or hostname.
# localhost always works; anything else not listed here is refused.
OFFICE_ALLOW_HOSTS=<office-address>,<office-hostname>

# Optional: other addresses PCs should fall back to, such as the machine's Tailscale address.
# Also add that address to OFFICE_ALLOW_HOSTS.
OFFICE_EXTRA_URLS=

# Optional: keep the key and names.txt in a folder instead of a Docker volume, so you can
# see, back up and edit them directly. The container then runs as that folder's owner:
# run `id -u` and `id -g` as that user for the numbers.
# OFFICE_DATA=./data
# OFFICE_UID=1000
# OFFICE_GID=1000
